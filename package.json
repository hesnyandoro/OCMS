{
  "name": "ocms",
  "version": "1.0.0",
  "description": "Organic Coffee Management System",
  "main": "backend/server.js",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "cd backend && npm start",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm ci && npm run build",
    "build:backend": "cd backend && npm ci --production"
  },
  "dependencies": {
    "@vercel/blob": "^0.27.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.17.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^6.14.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^6.2.1",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.1"
  },
  "overrides": {
    "path-to-regexp": "^0.1.13",
    "fast-xml-parser": "^5.3.5"
  },
  "author": "hesnyandoro",
  "license": "ISC"
}
