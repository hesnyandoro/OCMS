#!/bin/sh
# Refresh graphify-out and stage it so one commit contains code + graph.
# Enable this clone: git config core.hooksPath .githooks
# Skip: GRAPHIFY_SKIP_HOOK=1 git commit
#
# Do not run `graphify hook install` afterward — that restores post-commit
# and dirties the tree after every commit.

export PYTHONHASHSEED=0

if [ -n "${WINDIR:-}" ] || [ -n "${MSYSTEM:-}" ]; then
    export GRAPHIFY_MAX_WORKERS="${GRAPHIFY_MAX_WORKERS:-1}"
fi

[ "${GRAPHIFY_SKIP_HOOK:-0}" = "1" ] && exit 0

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$REPO_ROOT" || exit 0

GIT_DIR=${GIT_DIR:-$(git rev-parse --git-dir 2>/dev/null)}
[ -d "$GIT_DIR/rebase-merge" ] && exit 0
[ -d "$GIT_DIR/rebase-apply" ] && exit 0
[ -f "$GIT_DIR/MERGE_HEAD" ] && exit 0
[ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] && exit 0

_GFY_OUT="${GRAPHIFY_OUT:-graphify-out}"
_GFY_OUT="${_GFY_OUT%/}"

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED" ]; then
    exit 0
fi

_NON_GRAPH=$(printf '%s\n' "$STAGED" | while IFS= read -r _GFY_F; do
    case "$_GFY_F" in
        ("$_GFY_OUT"/*) ;;
        (*) printf '%s\n' "$_GFY_F" ;;
    esac
done)
if [ -z "$_NON_GRAPH" ]; then
    exit 0
fi

_GFY_PROBE="import importlib.util, sys; sys.exit(0 if importlib.util.find_spec('graphify') else 1)"
GRAPHIFY_PYTHON=""
_PINNED='C:/Users/Nyandoro/AppData/Roaming/uv/tools/graphifyy/Scripts/python.exe'
if [ -n "$_PINNED" ] && [ -x "$_PINNED" ] && "$_PINNED" -c "$_GFY_PROBE" 2>/dev/null; then
    GRAPHIFY_PYTHON="$_PINNED"
fi

if [ -z "$GRAPHIFY_PYTHON" ]; then
    _GFY_PYTHON_FILE="$_GFY_OUT/.graphify_python"
    if [ -f "$_GFY_PYTHON_FILE" ]; then
        _FROM_FILE=$(tr -d '[:space:]' < "$_GFY_PYTHON_FILE" 2>/dev/null)
        case "$_FROM_FILE" in
            *[!a-zA-Z0-9/_.@:\\-]*) _FROM_FILE="" ;;
        esac
        if [ -n "$_FROM_FILE" ] && [ -x "$_FROM_FILE" ] && "$_FROM_FILE" -c "$_GFY_PROBE" 2>/dev/null; then
            GRAPHIFY_PYTHON="$_FROM_FILE"
        fi
    fi
fi

if [ -z "$GRAPHIFY_PYTHON" ]; then
    for _GFY_CAND in \
        "$HOME/AppData/Roaming/uv/tools/graphifyy/Scripts/python.exe" \
        "$HOME/.local/share/uv/tools/graphifyy/bin/python"; do
        if [ -x "$_GFY_CAND" ] && "$_GFY_CAND" -c "$_GFY_PROBE" 2>/dev/null; then
            GRAPHIFY_PYTHON="$_GFY_CAND"
            break
        fi
    done
fi

if [ -z "$GRAPHIFY_PYTHON" ]; then
    if command -v python >/dev/null 2>&1 && python -c "$_GFY_PROBE" 2>/dev/null; then
        GRAPHIFY_PYTHON="python"
    elif command -v python3 >/dev/null 2>&1 && python3 -c "$_GFY_PROBE" 2>/dev/null; then
        GRAPHIFY_PYTHON="python3"
    else
        echo "[graphify pre-commit] graphify is not installed. Install with: uv tool install graphifyy" >&2
        echo "[graphify pre-commit] Or skip this once: GRAPHIFY_SKIP_HOOK=1 git commit" >&2
        exit 1
    fi
fi

echo "[graphify pre-commit] updating knowledge graph..."
if ! "$GRAPHIFY_PYTHON" -m graphify update .; then
    echo "[graphify pre-commit] graphify update failed. Fix the error or skip with GRAPHIFY_SKIP_HOOK=1" >&2
    exit 1
fi

git add -- "$_GFY_OUT"
echo "[graphify pre-commit] staged $_GFY_OUT"
exit 0
